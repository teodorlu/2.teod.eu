{:deps {this/this {:local/root "."}}
 :tasks
 {preview (shell "python3 -m http.server 8009")
  browse (shell "open http://localhost:8009")
  build {:requires ([t2.build :as build])
         :task (build/build build/published-ids build/draft-ids)}
  build-jtk {:requires ([t2.jtk :as jtk])
             :task (jtk/build)}
  build-deploy (do
                (shell "bb build")
                (shell "bb deploy"))
  deploy {:requires ([t2.deploy :as deploy])
          :task (deploy/deploy)}
  deploy-dry {:requires ([t2.deploy :as deploy])
              :task (deploy/deploy-dry)}
  cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
          :requires ([cljfmt.main :as cljfmt])
          :task (apply cljfmt/-main *command-line-args*)}
  reformat {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.13.1"}}
            :requires ([cljfmt.main :as cljfmt])
            :task (cljfmt/-main "fix" "src" "bb.edn")}
  lint.copy-configs {:doc "Import clj-kondo configs from dependencies"
                     :requires ([clojure.string :as str])
                     :task (let [cp (-> (shell {:out :string} "clojure -Spath")
                                        :out
                                        str/trim)]
                             (shell (str "clj-kondo --lint " cp " --dependencies --copy-configs --skip-lint")))}}}
